# ============================================================
#  line-rca-agent — environment template
#  Copy to `.env` and fill in. `.env` is gitignored; never commit real keys.
# ============================================================

# ---- runtime ---------------------------------------------------------------
LRC_ENV=dev
# 1 = run without any API key: fake LLM provider + seeded demo data.
LRC_DEMO_MODE=1

# ---- database --------------------------------------------------------------
# Docker compose provides this by default (pgvector image).
LRC_DATABASE_URL=postgresql+asyncpg://lrc:lrc@localhost:5432/lrc

# ---- LLM provider ----------------------------------------------------------
# deepseek | openai_compat | ollama | fake
LRC_LLM_PROVIDER=fake
LRC_LLM_MODEL=
# Only needed when LRC_LLM_PROVIDER is a remote provider.
DEEPSEEK_API_KEY=
LRC_LLM_BASE_URL=
LRC_LLM_TIMEOUT_SECONDS=60

# ---- agent knobs -----------------------------------------------------------
LRC_AGENT_MAX_STEPS=12
LRC_AGENT_ORCHESTRATOR=native
# native | langgraph   (both implementations must stay interchangeable)
LRC_AGENT_CONFIDENCE_THRESHOLD=0.6

# ---- data sources ----------------------------------------------------------
LRC_MQTT_URL=mqtt://localhost:1883
LRC_SECOM_PATH=eval/datasets/secom

# ---- observability ---------------------------------------------------------
# db | stdout | langfuse
LRC_TRACE_SINK=stdout
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- web -------------------------------------------------------------------
LRC_CORS_ORIGINS=http://localhost:5173
